        d.setColor(color);
        d.setCornerRadius(18);
        return d;
    }

    // ---------- 10. SHARED PREFERENCES ----------

    private void showSharedPreferences() {
        beginScreen("Experiment 10 - SharedPreferences");
        SharedPreferences prefs = getSharedPreferences("LoginPrefs", MODE_PRIVATE);
        EditText username = edit("Enter username", 1);
        CheckBox remember = new CheckBox(this);
        remember.setText("Remember Me");
        currentContent.addView(remember, matchWrap());

        boolean saved = prefs.getBoolean("remember_me", false);
        if (saved) {
            username.setText(prefs.getString("username", ""));
            remember.setChecked(true);
        }

        button("Save", () -> {
            String name = username.getText().toString().trim();
            if (name.isEmpty()) {
                toast("Please enter username");
                return;
            }
            SharedPreferences.Editor editor = prefs.edit();
            if (remember.isChecked()) {
                editor.putString("username", name);
                editor.putBoolean("remember_me", true);
                toast("Username saved");
            } else {
                editor.clear();
                toast("Remember Me disabled");
            }
            editor.apply();
        });

        button("Clear Saved Data", () -> {
            prefs.edit().clear().apply();
            username.setText("");
            remember.setChecked(false);
            toast("Preferences cleared");
        });
    }

