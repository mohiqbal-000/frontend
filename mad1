    // ---------- 3. EXPLICIT INTENT - TWO-SCREEN CALCULATOR ----------

    private void showExplicitIntent() {
        beginScreen("Experiment 3 - Explicit Intent Calculator");
        EditText first = edit("Enter first number", 8194);
        EditText second = edit("Enter second number", 8194);

        button("Add - Open Result Activity", () -> {
            try {
                double a = Double.parseDouble(first.getText().toString());
                double b = Double.parseDouble(second.getText().toString());

                // Explicit Intent: this Activity launches itself with result data.
                Intent intent = new Intent(MainActivity.this, MainActivity.class);
                intent.putExtra("show_sum", a + b);
                intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP);
                startActivity(intent);
            } catch (NumberFormatException e) {
                toast("Enter valid numbers");
            }
        });
    }

