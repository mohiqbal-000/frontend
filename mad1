    static class AnimalAdapter extends BaseAdapter {
        Context context;
        List<Animal> animals;

        AnimalAdapter(Context context, List<Animal> animals) {
            this.context = context;
            this.animals = animals;
        }

        @Override
        public int getCount() {
            return animals.size();
        }

        @Override
        public Object getItem(int position) {
            return animals.get(position);
        }

        @Override
        public long getItemId(int position) {
            return position;
        }

        @Override
        public View getView(int position, View convertView, ViewGroup parent) {
            LinearLayout row;
            if (convertView == null) {
                row = new LinearLayout(context);
                row.setOrientation(LinearLayout.HORIZONTAL);
                row.setPadding(10, 12, 10, 12);

                ImageView image = new ImageView(context);
                image.setId(1);
                image.setLayoutParams(new LinearLayout.LayoutParams(90, 90));
                row.addView(image);

                LinearLayout texts = new LinearLayout(context);
                texts.setOrientation(LinearLayout.VERTICAL);
                texts.setPadding(12, 4, 4, 4);

                TextView name = new TextView(context);
                name.setId(2);
                name.setTextSize(18);
                name.setTextColor(Color.BLACK);
                texts.addView(name);

                TextView desc = new TextView(context);
                desc.setId(3);
                desc.setTextSize(14);
                texts.addView(desc);

                row.addView(texts, new LinearLayout.LayoutParams(
                        0, ViewGroup.LayoutParams.WRAP_CONTENT, 1));
            } else {
                row = (LinearLayout) convertView;
            }

            Animal animal = animals.get(position);
            ((ImageView) row.findViewById(1)).setImageResource(animal.icon);
            ((TextView) row.findViewById(2)).setText(animal.name);
            ((TextView) row.findViewById(3)).setText(animal.description);
            return row;
        }
    }

    // ---------- 13. SQLITE CRUD ----------

    private void showSQLite() {
        beginScreen("Experiment 13 - SQLite CRUD");
        EditText name = edit("Student name", 1);
        EditText course = edit("Course", 1);
        TextView records = text("Records will appear here.");

        button("Insert", () -> {
            String n = name.getText().toString().trim();
            String c = course.getText().toString().trim();
            if (n.isEmpty() || c.isEmpty()) {
                toast("Enter name and course");
                return;
            }
            long id = dbHelper.insertStudent(n, c);
            toast(id == -1 ? "Insert failed" : "Record inserted");
            name.setText("");
            course.setText("");
            records.setText(dbHelper.getAllStudents());
        });

        button("Read All", () -> records.setText(dbHelper.getAllStudents()));

        EditText updateId = edit("ID to update", 2);
        button("Update First Matching ID", () -> {
            try {
                int id = Integer.parseInt(updateId.getText().toString());
                String n = name.getText().toString().trim();
                String c = course.getText().toString().trim();
                int rows = dbHelper.updateStudent(id, n, c);
                toast(rows > 0 ? "Record updated" : "ID not found");
                records.setText(dbHelper.getAllStudents());
            } catch (NumberFormatException e) {
                toast("Enter a valid ID, name and course");
            }
        });

        EditText deleteId = edit("ID to delete", 2);
        button("Delete", () -> {
            try {
                int id = Integer.parseInt(deleteId.getText().toString());
                int rows = dbHelper.deleteStudent(id);
                toast(rows > 0 ? "Record deleted" : "ID not found");
                records.setText(dbHelper.getAllStudents());
            } catch (NumberFormatException e) {
                toast("Enter a valid ID");
            }
        });

        records.setText(dbHelper.getAllStudents());
    }

    static class DBHelper extends SQLiteOpenHelper {
        private static final String DB_NAME = "StudentDB";
        private static final int DB_VERSION = 1;
        private static final String TABLE = "students";

        DBHelper(Context context) {
            super(context, DB_NAME, null, DB_VERSION);
        }

        @Override
        public void onCreate(SQLiteDatabase db) {
            db.execSQL("CREATE TABLE " + TABLE
                    + "(id INTEGER PRIMARY KEY AUTOINCREMENT, "
                    + "name TEXT, course TEXT)");
        }

        @Override
        public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
            db.execSQL("DROP TABLE IF EXISTS " + TABLE);
            onCreate(db);
        }

        long insertStudent(String name, String course) {
            SQLiteDatabase db = getWritableDatabase();
            ContentValues values = new ContentValues();
            values.put("name", name);
            values.put("course", course);
            return db.insert(TABLE, null, values);
        }

        String getAllStudents() {
            SQLiteDatabase db = getReadableDatabase();
            Cursor cursor = db.rawQuery("SELECT * FROM " + TABLE, null);
            StringBuilder result = new StringBuilder("STUDENT RECORDS\n");
            if (cursor.moveToFirst()) {
                do {
                    result.append("ID: ").append(cursor.getInt(0))
                            .append(" | Name: ").append(cursor.getString(1))
                            .append(" | Course: ").append(cursor.getString(2))
                            .append("\n");
                } while (cursor.moveToNext());
            } else {
                result.append("No records found.");
            }
            cursor.close();
            return result.toString();
        }

        int updateStudent(int id, String name, String course) {
            ContentValues values = new ContentValues();
            values.put("name", name);
            values.put("course", course);
            return getWritableDatabase().update(
                    TABLE, values, "id=?", new String[]{String.valueOf(id)});
        }

        int deleteStudent(int id) {
            return getWritableDatabase().delete(
                    TABLE, "id=?", new String[]{String.valueOf(id)});
        }
    }
